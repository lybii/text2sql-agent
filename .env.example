# Copy to .env and change every secret. Never commit .env.

# ---- PostgreSQL (owner + two least-privilege roles created by the migration) ----
POSTGRES_DB=text2sql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-owner
POSTGRES_PORT=5444
APP_BACKEND_PASSWORD=change-me-app
ANALYTICS_READER_PASSWORD=change-me-reader

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- LLM: "demo" runs fully offline (deterministic). "openai" needs a key. ----
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Tracing (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- HITL: "always" = every SQL needs approval; "risk_based" = low-risk aggregates auto-run ----
APPROVAL_MODE=always

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
